<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>14</LangVersion>
    <Version>0.3.0-alpha.1</Version><SkiaSharpVersion>3.119.2</SkiaSharpVersion>
    <Authors>Wiesław Šoltés</Authors><Company>Wiesław Šoltés</Company><Copyright>Copyright © 2026 Wiesław Šoltés</Copyright>
    <RepositoryUrl>https://github.com/wieslawsoltes/VideoSpace</RepositoryUrl><RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://wieslawsoltes.github.io/UnoSpace/projects/videospace/</PackageProjectUrl><PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageIcon>icon.png</PackageIcon>
    <PackageTags>videospace;video;video-editing;nonlinear-editing;timeline;audio;uno-platform;skiasharp;webassembly;desktop</PackageTags>
    <IncludeSymbols>true</IncludeSymbols><SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl><EmbedUntrackedSources>true</EmbedUntrackedSources><Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)build/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
